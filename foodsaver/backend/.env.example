NODE_ENV=production
PORT=4000

# MySQL Database Configuration (Cloud or Local)
# You can provide DATABASE_URL or individual DB_* credentials below
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=foodsaver
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=ca.pem
DB_AUTO_SEED=false

JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://localhost:5173

# Google OAuth & Maps
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
ROUTING_API_KEY=your_routing_key_here
GEOCODING_API_KEY=your_geocoding_key_here

# Email Communication System (Nodemailer / SMTP / Transactional Provider)
EMAIL_ENABLED=true
EMAIL_FROM="FoodSaver" <no-reply@foodsaver.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# SMS OTP Verification Provider ("fast2sms", "twilio", "msg91", or "mock")
SMS_PROVIDER=mock
OTP_EXPIRY_MINUTES=5
OTP_SECRET_SALT=your_otp_salt_secret_key

# Fast2SMS (Indian SMS Gateway)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_ROUTE=otp

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# MSG91 SMS (India)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here
MSG91_SENDER_ID=FDSAVR

# Initial Hotel Owner Seed Account (Local Development / Setup)
HOTEL_OWNER_NAME=FoodSaver Owner
HOTEL_OWNER_EMAIL=owner@foodsaver.local
HOTEL_OWNER_PASSWORD=your_secure_owner_password_here

# Initial Platform Administrator Seed Account (Local Development / Setup)
ADMIN_NAME=FoodSaver Administrator
ADMIN_EMAIL=admin@foodsaver.local
ADMIN_PASSWORD=your_secure_admin_password_here

